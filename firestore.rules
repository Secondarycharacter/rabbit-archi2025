rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /siteStats/{docId} {
      allow read, write: if true;
    }

    match /metaverseProjectOverviews/{overviewId} {
      allow read, write: if true;
    }

    match /homepageChatUsers/{userId} {
      allow read: if true;
      allow create: if request.resource.data.displayId is string
        && request.resource.data.displayId.size() > 0
        && request.resource.data.displayId.size() <= 16
        && request.resource.data.passwordHash is string
        && request.resource.data.salt is string
        && request.resource.data.iterations == 120000;
      allow update: if request.resource.data.diff(resource.data).changedKeys().hasOnly(['lastActiveAt']);
      allow delete: if false;
    }

    match /homepageChatRooms/{roomId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;

        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 16
          && (
            (
              messageId == 'opening'
              && request.resource.data.isSystem == true
              && request.resource.data.authorId == 'system'
            )
            || (
              request.resource.data.isSystem != true
              && request.resource.data.authorId is string
              && exists(/databases/$(database)/documents/homepageChatUsers/$(request.resource.data.authorId))
            )
          );

        allow update: if resource.data.isSystem != true
          && messageId != 'opening'
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;

        allow delete: if resource.data.isSystem != true
          && messageId != 'opening';
      }
    }
  }
}
