rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /homepageChatUsers/{userId} {
      allow read, write: if false;
    }

    match /homepageChatSessions/{sessionId} {
      allow read, write: if false;
    }

    match /homepageChatPinAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /homepageChatRooms/{roomId} {
      allow read: if true;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
